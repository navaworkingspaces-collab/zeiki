# Zeiki — Variables de entorno (PLANTILLA para CI)
#
# Este archivo es la FORMA del .env real, con valores DUMMY para que
# los tests corran en Code Magic. NO usar para dev (tienes tu propio
# assets/.env con valores reales) ni para producción (los valores
# se inyectan con --dart-define-from-file en el build de release).
#
# Los valores de aquí son placeholders. Los unit tests no tocan
# Supabase ni OAuth (usan fakes), así que cualquier string no-vacío
# funciona. El `EnvConfig.fromDotEnv` requiere que los campos
# requeridos NO estén vacíos (línea 70-76 de env_config.dart).
#
# Housekeeping #18 part 2: este archivo reemplaza al `assets/.env`
# real en CI. La razón: `assets/.env` está en .gitignore (conventions
# §10, secrets), entonces Code Magic no lo tiene. En lugar de
# generar uno dinámicamente con sed/awk, este template es la fuente
# única de valores dummy y se copia tal cual al inicio del workflow.

# ===== Supabase (ADR-003) =====
# URL del proyecto Supabase (formato: https://<project-id>.supabase.co)
SUPABASE_URL=https://ci-dummy.supabase.co

# Clave anónima (publishable, se incluye en el APK)
SUPABASE_ANON_KEY=ci-dummy-anon-key

# ===== Feature flags / Entorno =====
# 'development' | 'staging' | 'production'
APP_ENV=ci

# Habilita logs de debug (true/false)
DEBUG_LOGS=false

# ===== Google Sign-In (BUG-001, HDU-005) =====
# Web OAuth Client ID de Google (NO el Android, el Web).
# Dummy: cualquier string no-vacío funciona para que el `EnvConfig`
# no lance al boot de los tests.
GOOGLE_WEB_CLIENT_ID=ci-dummy.apps.googleusercontent.com
