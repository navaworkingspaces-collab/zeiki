<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- HDU-005b: `local_auth` necesita este permiso para mostrar el
         `BiometricPrompt` (huella/cara) en Android 9+ (API 28+). En API
         < 28 se usa `USE_FINGERPRINT` (deprecated pero conservado por
         compatibilidad con devices viejos). Sin esto, `authenticate()`
         lanza `SecurityException` en runtime. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <application
        android:label="Zeiki"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- HDU-004 AC5/AC10: deep links con esquema `zeiki://`.
                 El host es la ruta interna (ej. `zeiki://login` → /login).
                 `autoVerify="false"` porque no usamos App Links verificados
                 (HTTPS + assetlinks.json) — es scheme custom, deliberadamente
                 simple para MVP. Cuando se quiera abrir directo sin picker,
                 migrar a `https://zeiki.app/<ruta>` y agregar `assetlinks.json`
                 (spec HDU-004 §Riesgos).

                 Housekeeping bundle #3, fix #16: restringimos los hosts
                 válidos. Antes aceptaba CUALQUIER `zeiki://*`; ahora solo
                 los 6 hosts whitelisted que corresponden a rutas reales
                 (mantener en sync con `AppRoute` en app_router.dart y
                 `_allowedDeepLinkHosts` en app_links_handler.dart).
                 Defensa en profundidad: si un intent externo intenta
                 abrir `zeiki://admin`, el SO no muestra Zeiki en el
                 chooser, así que ni siquiera llega al plugin. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zeiki" android:host="splash" />
                <data android:scheme="zeiki" android:host="onboarding" />
                <data android:scheme="zeiki" android:host="login" />
                <data android:scheme="zeiki" android:host="register" />
                <data android:scheme="zeiki" android:host="unlock" />
                <data android:scheme="zeiki" android:host="home" />
            </intent-filter>
            <!-- HDU-007 (AC2, AC8): deep links del SDK de Supabase.
                 El scheme `io.supabase.flutter` lo usa Supabase para
                 los links de email confirmation y reset password. Sin
                 este intent-filter, el link del email abriría el
                 navegador (no la app) y el user quedaría sin confirmar
                 o sin poder cambiar su contraseña.

                 Mantenemos `login-callback` por compatibilidad con el
                 legacy `seiki_app`, aunque el flujo de Google Sign-In
                 de Zeiki no lo usa (Zeiki usa `signInWithIdToken`
                 directo, no OAuth de Supabase). El handler
                 `_allowedDeepLinkSchemes` de `app_links_handler.dart`
                 acepta el scheme, pero `_allowedDeepLinkHosts` NO
                 incluye `login-callback` (defense in depth: el callback
                 lo procesa `supabase_flutter._startDeeplinkObserver`,
                 no nuestro handler).

                 Mismo `autoVerify="false"` que el intent-filter de
                 `zeiki://` por la misma razón: scheme custom, no App
                 Links verificados. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="io.supabase.flutter" android:host="login-callback" />
                <data android:scheme="io.supabase.flutter" android:host="verify-email" />
                <data android:scheme="io.supabase.flutter" android:host="reset-password" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
